{
  "name": "banma-collector",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tauri": "pnpm build && vite preview --host 127.0.0.1 --port 1420 --strictPort",
    "runtime:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-runtime.ps1",
    "bundle:windows": "pnpm runtime:prepare && tauri build --bundles nsis --config src-tauri/tauri.release.conf.json",
    "format:web": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"*.{json,ts,md}\" \".github/**/*.yml\"",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:scripts": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/format-powershell.ps1",
    "format": "pnpm format:web && pnpm format:rust && pnpm format:scripts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"*.{json,ts,md}\" \".github/**/*.yml\" && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/format-powershell.ps1 -Check",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "tsc -b",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "pnpm test:unit && pnpm test:e2e"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.85.5",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-store": "^2.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "^7.8.2",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@tauri-apps/cli": "^2.8.4",
    "@tailwindcss/vite": "^4.1.12",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.8.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2"
  },
  "packageManager": "pnpm@10.14.0"
}
